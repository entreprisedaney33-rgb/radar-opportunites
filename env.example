# Copier en `.env` (jamais commité — voir .gitignore racine du dépôt) et
# remplir. Aucune valeur ci-dessous n'est un vrai secret.

# Postgres en production (Render) ; en local, sqlite:///./radar_local.db si absent.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/radar

# Clé API Claude (Anthropic) — sans elle, Scout/Analyst/Critic tournent en
# mode heuristique honnête (aucune extraction automatique, tout marqué
# "à confirmer"), jamais en inventant des faits.
ANTHROPIC_API_KEY=

# Modèles utilisés (tri = Scout, sur beaucoup de signaux ; approfondi =
# Analyst/Critic, sur les finalistes). Vérifier les tarifs réels avant un
# run non --dry-run (voir app/adapters/model_client.py).
RADAR_MODEL_TRI=claude-haiku-4-5-20251001
RADAR_MODEL_APPROFONDI=claude-sonnet-5

# Optionnel — laisser vide pour désactiver l'adaptateur Apify (voir
# config/sources_autorisees.yaml, apify.actif doit aussi être mis à true).
APIFY_TOKEN=

# Mot de passe HTTP Basic de l'interface interne (app/web/server.py). Sans
# valeur, l'interface refuse TOUT accès (jamais ouverte par défaut).
RADAR_UI_PASSWORD=

# Mettre à "1" pour arrêter immédiatement toute exécution (cron ET commande
# manuelle), indépendamment du bouton pause de l'interface web.
RADAR_PAUSE_ALL=
