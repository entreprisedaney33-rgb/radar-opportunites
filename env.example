# Copier en `.env` (jamais commité — voir .gitignore racine du dépôt) et
# remplir. Aucune valeur ci-dessous n'est un vrai secret.

# Postgres en production (Render) ; en local, sqlite:///./radar_local.db si absent.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/radar

# Connexion dédiée de `python -m app.metriques`, à un utilisateur Postgres
# EN LECTURE SEULE (voir sous-étape 0.4 d'AMELIORATIONS.md pour les lignes
# SQL de création). Volontairement séparée de DATABASE_URL ci-dessus, qui a
# les droits d'écriture du reste de l'application. Sans cette variable,
# app.metriques s'arrête avec un message clair, jamais de repli.
RADAR_DATABASE_URL=postgresql+psycopg://radar_lecture:password@host:5432/radar_opportunites

# Clé API Claude (Anthropic) — sans elle, Scout/Analyst/Critic tournent en
# mode heuristique honnête (aucune extraction automatique, tout marqué
# "à confirmer"), jamais en inventant des faits.
ANTHROPIC_API_KEY=

# Modèles utilisés (tri = Scout, sur beaucoup de signaux ; approfondi =
# Analyst/Critic, sur les finalistes). Vérifier les tarifs réels avant un
# run non --dry-run (voir app/adapters/model_client.py).
RADAR_MODEL_TRI=claude-haiku-4-5-20251001
RADAR_MODEL_APPROFONDI=claude-sonnet-5

# Optionnel — laisser vide pour désactiver l'adaptateur Apify (voir
# config/sources_autorisees.yaml, apify.actif doit aussi être mis à true).
APIFY_TOKEN=

# Mot de passe HTTP Basic de l'interface interne (app/web/server.py). Sans
# valeur, l'interface refuse TOUT accès (jamais ouverte par défaut).
RADAR_UI_PASSWORD=

# Mettre à "1" pour arrêter immédiatement toute exécution (cron ET commande
# manuelle), indépendamment du bouton pause de l'interface web.
RADAR_PAUSE_ALL=

# Sous-étape 3.17 : si définie (horodatage ISO 8601 UTC, ex. 2026-09-26T13:41Z),
# le worker marque `a_reprendre` au démarrage les dossiers créés depuis cette
# date uniquement par repli sans modèle (même logique que `python -m
# app.reprise --depuis`), puis la phase de reprise les retraite en priorité.
# Idempotent ; résumé dans les logs et `runs.erreurs_json`. À poser dans Render
# (jamais une valeur secrète), à retirer une fois la reprise terminée.
RADAR_REPRISE_DEPUIS=

# Fournisseur "moteur web" payant de l'Enquêteur (sous-étape 3.5
# d'AMELIORATIONS.md, Brave Search API) -- NON UTILISÉ par le pipeline réel
# tant que la sous-étape 4.3 ne l'y branche pas explicitement. Les DEUX
# valeurs restent vides ici : ne jamais les remplir sans avoir vérifié un
# plafond de dépense côté compte Brave (hors du contrôle de ce projet).
RADAR_BRAVE_SEARCH_API_KEY=
RADAR_ENQUETEUR_ACTIF_BRAVE_SEARCH=

# Sous-étape 4.0 : API officielle Reddit (OAuth application, script). Les trois
# valeurs restent vides ici et NE SONT JAMAIS commitées ; en production elles
# sont posées par Mathéo dans Render (Environment du worker). Sans elles,
# aucune collecte Reddit (jamais de repli RSS). Format de l'agent utilisateur
# exigé par Reddit : radar-opportunites/1.0 (by /u/<pseudo>).
RADAR_REDDIT_CLIENT_ID=
RADAR_REDDIT_CLIENT_SECRET=
RADAR_REDDIT_USER_AGENT=

# Sous-étape 4.1 : deux interrupteurs de reprise, éteints par défaut (posés
# par Mathéo dans Render quand il le décide, jamais par le code).
# RADAR_RECALCUL_4_1=1 : au démarrage du worker, recalcule les scores à la
# règle actuelle (nouvelle ligne, ancienne conservée) et passe les dossiers
# dont le dernier score est < 50 au statut archive_faible. 0 €, idempotent.
# RADAR_FAISABILITE_REPRISE=1 : à chaque passage, calcule la faisabilité des
# dossiers >= 50 qui n'en ont pas (un appel court par dossier, dans le budget).
RADAR_RECALCUL_4_1=
RADAR_FAISABILITE_REPRISE=
